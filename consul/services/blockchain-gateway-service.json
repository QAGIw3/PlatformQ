{
  "service": {
    "name": "blockchain-gateway-service",
    "tags": [
      "blockchain",
      "gateway",
      "web3",
      "api"
    ],
    "port": 8000,
    "meta": {
      "version": "1.0.0",
      "protocol": "http",
      "chains": "ethereum,polygon,arbitrum,optimism"
    },
    "check": {
      "id": "blockchain-gateway-health",
      "name": "HTTP Health Check",
      "http": "http://localhost:8000/health",
      "method": "GET",
      "interval": "10s",
      "timeout": "5s"
    },
    "connect": {
      "sidecar_service": {
        "port": 21010,
        "proxy": {
          "local_service_address": "127.0.0.1",
          "local_service_port": 8000,
          "config": {
            "protocol": "http",
            "envoy_prometheus_bind_addr": "0.0.0.0:9112"
          },
          "upstreams": [
            {
              "destination_name": "vault",
              "local_bind_port": 5100,
              "config": {
                "protocol": "http"
              }
            },
            {
              "destination_name": "auth-service",
              "local_bind_port": 5101,
              "config": {
                "protocol": "http"
              }
            },
            {
              "destination_name": "ignite-cache",
              "local_bind_port": 5102,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "pulsar",
              "local_bind_port": 5103,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "cassandra",
              "local_bind_port": 5104,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "graph-intelligence-service",
              "local_bind_port": 5105,
              "config": {
                "protocol": "http"
              }
            },
            {
              "destination_name": "compliance-service",
              "local_bind_port": 5106,
              "config": {
                "protocol": "http"
              }
            }
          ]
        },
        "checks": [
          {
            "name": "Connect Sidecar Listening",
            "tcp": "127.0.0.1:21010",
            "interval": "10s"
          },
          {
            "name": "Connect Sidecar Alive",
            "alias_service": "blockchain-gateway-service"
          }
        ]
      }
    }
  }
} 