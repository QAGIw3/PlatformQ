{
  "service": {
    "name": "risk-management-service",
    "tags": [
      "deprecated",
      "merged-into-risk-engine"
    ],
    "port": 8082,
    "meta": {
      "version": "2.0.0-deprecated",
      "protocol": "http",
      "deprecated": "true",
      "replacement_service": "risk-engine-service",
      "deprecation_notice": "This service has been merged into risk-engine-service. Please update your integrations to use risk-engine-service instead."
    },
    "check": {
      "id": "risk-management-service-health",
      "name": "Deprecated Service Check",
      "http": "http://localhost:8082/health",
      "method": "GET",
      "interval": "30s",
      "timeout": "5s",
      "notes": "This service is deprecated and merged into risk-engine-service"
    },
    "connect": {
      "sidecar_service": {
        "port": 21041,
        "proxy": {
          "local_service_address": "127.0.0.1",
          "local_service_port": 8000,
          "config": {
            "protocol": "http",
            "envoy_prometheus_bind_addr": "0.0.0.0:9143"
          },
          "upstreams": [
            {
              "destination_name": "auth-service",
              "local_bind_port": 5041,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "risk-engine-service",
              "local_bind_port": 5042,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "market-data-service",
              "local_bind_port": 5043,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "ignite-cache",
              "local_bind_port": 5044,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "pulsar",
              "local_bind_port": 5045,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "cassandra",
              "local_bind_port": 5046,
              "config": {
                "protocol": "tcp"
              }
            }
          ]
        },
        "checks": [
          {
            "name": "Connect Sidecar Listening",
            "tcp": "127.0.0.1:21041",
            "interval": "10s"
          },
          {
            "name": "Connect Sidecar Alive",
            "alias_service": "risk-management-service"
          }
        ]
      }
    }
  }
}