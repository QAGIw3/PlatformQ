{
  "service": {
    "name": "data-platform-service",
    "tags": [
      "dataintelligence",
      "v2",
      "ingestion",
      "lakehouse",
      "catalog"
    ],
    "port": 8010,
    "meta": {
      "version": "2.0.0",
      "replaces": "data-ingestion-service,storage-service,data-catalog-hub",
      "description": "Consolidated data platform service"
    },
    "check": {
      "http": "http://localhost:8010/api/v1/health",
      "interval": "10s",
      "timeout": "5s"
    },
    "connect": {
      "sidecar_service": {
        "proxy": {
          "upstreams": [
            {
              "destination_name": "cassandra",
              "local_bind_port": 9042
            },
            {
              "destination_name": "janusgraph",
              "local_bind_port": 8182
            },
            {
              "destination_name": "elasticsearch",
              "local_bind_port": 9200
            },
            {
              "destination_name": "pulsar",
              "local_bind_port": 6650
            },
            {
              "destination_name": "minio",
              "local_bind_port": 9000
            },
            {
              "destination_name": "ignite",
              "local_bind_port": 10800
            }
          ]
        }
      }
    }
  }
}