{
  "service": {
    "name": "search-service",
    "tags": [
      "search",
      "indexing",
      "discovery",
      "api"
    ],
    "port": 8000,
    "meta": {
      "version": "1.0.0",
      "protocol": "http",
      "search_engine": "elasticsearch"
    },
    "check": {
      "id": "search-service-health",
      "name": "HTTP Health Check",
      "http": "http://localhost:8000/health",
      "method": "GET",
      "interval": "10s",
      "timeout": "5s"
    },
    "connect": {
      "sidecar_service": {
        "port": 21042,
        "proxy": {
          "local_service_address": "127.0.0.1",
          "local_service_port": 8000,
          "config": {
            "protocol": "http",
            "envoy_prometheus_bind_addr": "0.0.0.0:9144"
          },
          "upstreams": [
            {
              "destination_name": "auth-service",
              "local_bind_port": 5042,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "data-platform-service",
              "local_bind_port": 5043,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "elasticsearch",
              "local_bind_port": 5044,
              "config": {
                "protocol": "http"
              }
            },
            {
              "destination_name": "ignite-cache",
              "local_bind_port": 5045,
              "config": {
                "protocol": "tcp"
              }
            }
          ]
        },
        "checks": [
          {
            "name": "Connect Sidecar Listening",
            "tcp": "127.0.0.1:21042",
            "interval": "10s"
          },
          {
            "name": "Connect Sidecar Alive",
            "alias_service": "search-service"
          }
        ]
      }
    }
  }
}