{
  "service": {
    "id": "risk-engine-service-001",
    "name": "risk-engine-service",
    "tags": [
      "api",
      "risk",
      "monitoring",
      "ml",
      "real-time",
      "direct-comm"
    ],
    "address": "risk-engine-service",
    "port": 8021,
    "meta": {
      "version": "2.0.0",
      "protocol": "http",
      "service_type": "core",
      "direct_comm_enabled": "true",
      "ml_enabled": "true",
      "monitoring_enabled": "true",
      "flink_enabled": "true"
    },
    "check": {
      "id": "risk-engine-service-health",
      "name": "Risk Engine Service Health Check",
      "http": "http://risk-engine-service:8021/health",
      "interval": "10s",
      "timeout": "5s"
    },
    "weights": {
      "passing": 10,
      "warning": 5
    },
    "enable_tag_override": false,
    "connect": {
      "sidecar_service": {
        "port": 20021,
        "proxy": {
          "upstreams": [
            {
              "destination_name": "ignite",
              "local_bind_port": 10800
            },
            {
              "destination_name": "pulsar",
              "local_bind_port": 6650
            },
            {
              "destination_name": "cassandra",
              "local_bind_port": 9042
            },
            {
              "destination_name": "elasticsearch",
              "local_bind_port": 9200
            },
            {
              "destination_name": "market-data-service",
              "local_bind_port": 8080
            },
            {
              "destination_name": "position-service",
              "local_bind_port": 8081
            },
            {
              "destination_name": "mlflow",
              "local_bind_port": 5000
            }
          ]
        }
      }
    }
  }
}