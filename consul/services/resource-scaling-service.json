{
  "service": {
    "name": "resource-scaling-service",
    "tags": ["scaling", "autoscaling", "resource-management"],
    "port": 8003,
    "meta": {
      "version": "1.0.0",
      "description": "Provides auto-scaling capabilities",
      "endpoints": {
        "policies": "/api/v1/policies/{service_name}",
        "decisions": "/api/v1/decisions",
        "predictions": "/api/v1/predictions/{service_name}"
      }
    },
    "check": {
      "id": "resource-scaling-health",
      "name": "HTTP API Health",
      "http": "http://resource-scaling-service:8003/health",
      "interval": "10s",
      "timeout": "5s"
    },
    "enable_tag_override": false
  }
} 