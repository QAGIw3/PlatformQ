{
  "service": {
    "name": "auth-service",
    "tags": [
      "security",
      "authentication",
      "authorization",
      "api"
    ],
    "port": 8000,
    "meta": {
      "version": "1.0.0",
      "protocol": "http",
      "auth_methods": "jwt,oauth2,oidc,apikey"
    },
    "check": {
      "id": "auth-health",
      "name": "HTTP Health Check",
      "http": "http://localhost:8000/health",
      "method": "GET",
      "interval": "10s",
      "timeout": "5s"
    },
    "connect": {
      "sidecar_service": {
        "port": 21000,
        "proxy": {
          "local_service_address": "127.0.0.1",
          "local_service_port": 8000,
          "config": {
            "protocol": "http",
            "envoy_prometheus_bind_addr": "0.0.0.0:9102"
          },
          "upstreams": [
            {
              "destination_name": "vault",
              "local_bind_port": 5000,
              "config": {
                "protocol": "http"
              }
            },
            {
              "destination_name": "ignite-cache",
              "local_bind_port": 5001,
              "config": {
                "protocol": "tcp",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "pulsar",
              "local_bind_port": 5002,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "cassandra",
              "local_bind_port": 5003,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "compliance-service",
              "local_bind_port": 5004,
              "config": {
                "protocol": "http"
              }
            },
            {
              "destination_name": "security-service",
              "local_bind_port": 5005,
              "config": {
                "protocol": "http"
              }
            }
          ]
        },
        "checks": [
          {
            "name": "Connect Sidecar Listening",
            "tcp": "127.0.0.1:21000",
            "interval": "10s"
          },
          {
            "name": "Connect Sidecar Alive",
            "alias_service": "auth-service"
          }
        ]
      }
    }
  }
} 