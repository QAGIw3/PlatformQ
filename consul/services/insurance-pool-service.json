{
  "service": {
    "name": "insurance-pool-service",
    "tags": [
      "insurance",
      "risk-pool",
      "coverage",
      "api"
    ],
    "port": 8000,
    "meta": {
      "version": "1.0.0",
      "protocol": "http",
      "coverage_types": "smart_contract,slashing,impermanent_loss"
    },
    "check": {
      "id": "insurance-pool-service-health",
      "name": "HTTP Health Check",
      "http": "http://localhost:8000/health",
      "method": "GET",
      "interval": "10s",
      "timeout": "5s"
    },
    "connect": {
      "sidecar_service": {
        "port": 21034,
        "proxy": {
          "local_service_address": "127.0.0.1",
          "local_service_port": 8000,
          "config": {
            "protocol": "http",
            "envoy_prometheus_bind_addr": "0.0.0.0:9136"
          },
          "upstreams": [
            {
              "destination_name": "auth-service",
              "local_bind_port": 5034,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "blockchain-gateway-service",
              "local_bind_port": 5035,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "risk-management-service",
              "local_bind_port": 5036,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "ignite-cache",
              "local_bind_port": 5037,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "pulsar",
              "local_bind_port": 5038,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "cassandra",
              "local_bind_port": 5039,
              "config": {
                "protocol": "tcp"
              }
            }
          ]
        },
        "checks": [
          {
            "name": "Connect Sidecar Listening",
            "tcp": "127.0.0.1:21034",
            "interval": "10s"
          },
          {
            "name": "Connect Sidecar Alive",
            "alias_service": "insurance-pool-service"
          }
        ]
      }
    }
  }
}