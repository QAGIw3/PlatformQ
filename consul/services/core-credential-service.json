{
  "service": {
    "name": "core-credential-service",
    "tags": [
      "credential",
      "api",
      "python"
    ],
    "address": "core-credential-service",
    "port": 8050,
    "meta": {
      "version": "1.0.0",
      "description": "W3C Verifiable Credential issuance and verification service",
      "api_prefix": "/api/v1"
    },
    "checks": [
      {
        "id": "core-credential-health",
        "name": "Core Credential Service Health Check",
        "http": "http://core-credential-service:8050/health",
        "interval": "10s",
        "timeout": "5s"
      }
    ],
    "connect": {
      "sidecar_service": {
        "proxy": {
          "upstreams": [
            {
              "destination_name": "storage-service",
              "local_bind_port": 8001
            },
            {
              "destination_name": "key-management-service",
              "local_bind_port": 8088
            },
            {
              "destination_name": "blockchain-connector-service",
              "local_bind_port": 8086
            },
            {
              "destination_name": "did-service",
              "local_bind_port": 8051
            },
            {
              "destination_name": "vault",
              "local_bind_port": 8200
            }
          ]
        }
      }
    }
  }
} 