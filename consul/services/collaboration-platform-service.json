{
  "service": {
    "name": "collaboration-platform-service",
    "tags": [
      "collaboration",
      "communication",
      "social",
      "api"
    ],
    "port": 8000,
    "meta": {
      "version": "1.0.0",
      "protocol": "http",
      "features": "chat,video,screen_sharing,whiteboard"
    },
    "check": {
      "id": "collaboration-platform-service-health",
      "name": "HTTP Health Check",
      "http": "http://localhost:8000/health",
      "method": "GET",
      "interval": "10s",
      "timeout": "5s"
    },
    "connect": {
      "sidecar_service": {
        "port": 21051,
        "proxy": {
          "local_service_address": "127.0.0.1",
          "local_service_port": 8000,
          "config": {
            "protocol": "http",
            "envoy_prometheus_bind_addr": "0.0.0.0:9153"
          },
          "upstreams": [
            {
              "destination_name": "auth-service",
              "local_bind_port": 5051,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "storage-service",
              "local_bind_port": 5052,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "event-router-service",
              "local_bind_port": 5053,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "ignite-cache",
              "local_bind_port": 5054,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "pulsar",
              "local_bind_port": 5055,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "cassandra",
              "local_bind_port": 5056,
              "config": {
                "protocol": "tcp"
              }
            }
          ]
        },
        "checks": [
          {
            "name": "Connect Sidecar Listening",
            "tcp": "127.0.0.1:21051",
            "interval": "10s"
          },
          {
            "name": "Connect Sidecar Alive",
            "alias_service": "collaboration-platform-service"
          }
        ]
      }
    }
  }
}