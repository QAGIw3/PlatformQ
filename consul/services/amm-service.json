{
  "service": {
    "name": "amm-service",
    "tags": [
      "defi",
      "liquidity",
      "amm",
      "api"
    ],
    "port": 8000,
    "meta": {
      "version": "1.0.0",
      "protocol": "http",
      "pool_types": "concentrated,stableswap"
    },
    "check": {
      "id": "amm-health",
      "name": "HTTP Health Check",
      "http": "http://localhost:8000/health",
      "method": "GET",
      "interval": "10s",
      "timeout": "5s"
    },
    "connect": {
      "sidecar_service": {
        "port": 21001,
        "proxy": {
          "local_service_address": "127.0.0.1",
          "local_service_port": 8000,
          "config": {
            "protocol": "http",
            "envoy_prometheus_bind_addr": "0.0.0.0:9102"
          },
          "upstreams": [
            {
              "destination_name": "oracle-service",
              "local_bind_port": 5010,
              "config": {
                "limits": {
                  "max_connections": 50,
                  "max_pending_requests": 25,
                  "max_concurrent_requests": 25
                }
              }
            },
            {
              "destination_name": "options-service",
              "local_bind_port": 5011,
              "config": {
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "futures-service",
              "local_bind_port": 5012,
              "config": {
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "ignite-cache",
              "local_bind_port": 5013,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "pulsar",
              "local_bind_port": 5014,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "cassandra",
              "local_bind_port": 5015,
              "config": {
                "protocol": "tcp"
              }
            }
          ]
        },
        "checks": [
          {
            "name": "Connect Sidecar Listening",
            "tcp": "127.0.0.1:21001",
            "interval": "10s"
          },
          {
            "name": "Connect Sidecar Alive",
            "alias_service": "amm-service"
          }
        ]
      }
    }
  }
} 