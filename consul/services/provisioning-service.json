{
  "service": {
    "name": "provisioning-service",
    "tags": [
      "provisioning",
      "infrastructure",
      "cloudstack",
      "api"
    ],
    "port": 8000,
    "meta": {
      "version": "1.0.0",
      "protocol": "http",
      "providers": "cloudstack,kubernetes,openstack"
    },
    "check": {
      "id": "provisioning-service-health",
      "name": "HTTP Health Check",
      "http": "http://localhost:8000/health",
      "method": "GET",
      "interval": "10s",
      "timeout": "5s"
    },
    "connect": {
      "sidecar_service": {
        "port": 21038,
        "proxy": {
          "local_service_address": "127.0.0.1",
          "local_service_port": 8000,
          "config": {
            "protocol": "http",
            "envoy_prometheus_bind_addr": "0.0.0.0:9140"
          },
          "upstreams": [
            {
              "destination_name": "auth-service",
              "local_bind_port": 5038,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "compute-allocation-service",
              "local_bind_port": 5039,
              "config": {
                "protocol": "http",
                "limits": {
                  "max_connections": 100,
                  "max_pending_requests": 50,
                  "max_concurrent_requests": 50
                }
              }
            },
            {
              "destination_name": "vault",
              "local_bind_port": 5040,
              "config": {
                "protocol": "http"
              }
            },
            {
              "destination_name": "ignite-cache",
              "local_bind_port": 5041,
              "config": {
                "protocol": "tcp"
              }
            },
            {
              "destination_name": "pulsar",
              "local_bind_port": 5042,
              "config": {
                "protocol": "tcp"
              }
            }
          ]
        },
        "checks": [
          {
            "name": "Connect Sidecar Listening",
            "tcp": "127.0.0.1:21038",
            "interval": "10s"
          },
          {
            "name": "Connect Sidecar Alive",
            "alias_service": "provisioning-service"
          }
        ]
      }
    }
  }
}