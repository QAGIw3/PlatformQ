{
  "service": {
    "name": "provisioning-service",
    "tags": ["compute", "provisioning", "cloud"],
    "port": 8000,
    "meta": {
      "version": "2.0.0",
      "description": "Handles compute resource provisioning across cloud providers",
      "refactored": "true",
      "endpoints": {
        "provision": "/api/v1/compute/provision",
        "status": "/api/v1/compute/provision/{allocation_id}",
        "capacity": "/api/v1/compute/capacity"
      }
    },
    "check": {
      "id": "provisioning-health",
      "name": "HTTP API Health",
      "http": "http://provisioning-service:8000/health",
      "interval": "10s",
      "timeout": "5s"
    },
    "enable_tag_override": false
  }
}