IGNITE_URL=http://localhost:10800

# Analytics engines (if applicable)
TRINO_URL=http://localhost:8080
DRUID_URL=http://localhost:8888
PINOT_URL=http://localhost:9000
CLICKHOUSE_URL=http://localhost:8123
DORIS_URL=http://localhost:8030

# ML (if applicable)
