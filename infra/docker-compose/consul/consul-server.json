{
  "server": true,
  "bootstrap_expect": 3,
  "datacenter": "platformq-dc1",
  "data_dir": "/consul/data",
  "log_level": "INFO",
  "node_name": "consul-server",
  "encrypt": "REPLACE_WITH_CONSUL_ENCRYPT_KEY",
  "ui_config": {
    "enabled": true
  },
  "connect": {
    "enabled": true
  },
  "ports": {
    "grpc": 8502
  },
  "addresses": {
    "http": "0.0.0.0",
    "https": "0.0.0.0",
    "grpc": "0.0.0.0"
  },
  "telemetry": {
    "prometheus_retention_time": "30s",
    "disable_hostname": true
  },
  "acl": {
    "enabled": true,
    "default_policy": "allow",
    "enable_token_persistence": true
  },
  "performance": {
    "raft_multiplier": 1
  }
} 