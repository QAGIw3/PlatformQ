<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="ignite.cfg" class="org.apache.ignite.configuration.IgniteConfiguration">
        <!-- Cluster name -->
        <property name="igniteInstanceName" value="credential-services-cluster"/>
        
        <!-- Enable peer class loading -->
        <property name="peerClassLoadingEnabled" value="true"/>
        
        <!-- Memory configuration -->
        <property name="dataStorageConfiguration">
            <bean class="org.apache.ignite.configuration.DataStorageConfiguration">
                <!-- Default memory region -->
                <property name="defaultDataRegionConfiguration">
                    <bean class="org.apache.ignite.configuration.DataRegionConfiguration">
                        <property name="name" value="Default_Region"/>
                        <!-- 256 MB initial size -->
                        <property name="initialSize" value="#{256 * 1024 * 1024}"/>
                        <!-- 1 GB maximum size -->
                        <property name="maxSize" value="#{1024 * 1024 * 1024}"/>
                        <!-- Enable persistence -->
                        <property name="persistenceEnabled" value="true"/>
                    </bean>
                </property>
                
                <!-- Storage path -->
                <property name="storagePath" value="/persistence/storage"/>
                <property name="walPath" value="/persistence/wal"/>
                <property name="walArchivePath" value="/persistence/wal/archive"/>
            </bean>
        </property>
        
        <!-- Cache configurations -->
        <property name="cacheConfiguration">
            <list>
                <!-- Credential cache -->
                <bean class="org.apache.ignite.configuration.CacheConfiguration">
                    <property name="name" value="credentials"/>
                    <property name="atomicityMode" value="ATOMIC"/>
                    <property name="cacheMode" value="PARTITIONED"/>
                    <property name="backups" value="1"/>
                    <property name="statisticsEnabled" value="true"/>
                    <property name="expiryPolicyFactory">
                        <bean class="javax.cache.expiry.CreatedExpiryPolicy" factory-method="factoryOf">
                            <constructor-arg>
                                <bean class="javax.cache.expiry.Duration">
                                    <constructor-arg value="HOURS"/>
                                    <constructor-arg value="24"/>
                                </bean>
                            </constructor-arg>
                        </bean>
                    </property>
                </bean>
                
                <!-- DID cache -->
                <bean class="org.apache.ignite.configuration.CacheConfiguration">
                    <property name="name" value="did_documents"/>
                    <property name="atomicityMode" value="ATOMIC"/>
                    <property name="cacheMode" value="PARTITIONED"/>
                    <property name="backups" value="1"/>
                    <property name="statisticsEnabled" value="true"/>
                    <property name="expiryPolicyFactory">
                        <bean class="javax.cache.expiry.CreatedExpiryPolicy" factory-method="factoryOf">
                            <constructor-arg>
                                <bean class="javax.cache.expiry.Duration">
                                    <constructor-arg value="HOURS"/>
                                    <constructor-arg value="24"/>
                                </bean>
                            </constructor-arg>
                        </bean>
                    </property>
                </bean>
                
                <!-- ZKP proofs cache -->
                <bean class="org.apache.ignite.configuration.CacheConfiguration">
                    <property name="name" value="zkp_proofs"/>
                    <property name="atomicityMode" value="ATOMIC"/>
                    <property name="cacheMode" value="PARTITIONED"/>
                    <property name="backups" value="1"/>
                    <property name="statisticsEnabled" value="true"/>
                    <property name="expiryPolicyFactory">
                        <bean class="javax.cache.expiry.CreatedExpiryPolicy" factory-method="factoryOf">
                            <constructor-arg>
                                <bean class="javax.cache.expiry.Duration">
                                    <constructor-arg value="HOURS"/>
                                    <constructor-arg value="1"/>
                                </bean>
                            </constructor-arg>
                        </bean>
                    </property>
                </bean>
                
                <!-- ZKP verification results cache -->
                <bean class="org.apache.ignite.configuration.CacheConfiguration">
                    <property name="name" value="zkp_verifications"/>
                    <property name="atomicityMode" value="ATOMIC"/>
                    <property name="cacheMode" value="PARTITIONED"/>
                    <property name="backups" value="1"/>
                    <property name="statisticsEnabled" value="true"/>
                    <property name="expiryPolicyFactory">
                        <bean class="javax.cache.expiry.CreatedExpiryPolicy" factory-method="factoryOf">
                            <constructor-arg>
                                <bean class="javax.cache.expiry.Duration">
                                    <constructor-arg value="MINUTES"/>
                                    <constructor-arg value="5"/>
                                </bean>
                            </constructor-arg>
                        </bean>
                    </property>
                </bean>
                
                <!-- Public keys cache -->
                <bean class="org.apache.ignite.configuration.CacheConfiguration">
                    <property name="name" value="zkp_public_keys"/>
                    <property name="atomicityMode" value="ATOMIC"/>
                    <property name="cacheMode" value="REPLICATED"/>
                    <property name="statisticsEnabled" value="true"/>
                    <property name="expiryPolicyFactory">
                        <bean class="javax.cache.expiry.CreatedExpiryPolicy" factory-method="factoryOf">
                            <constructor-arg>
                                <bean class="javax.cache.expiry.Duration">
                                    <constructor-arg value="DAYS"/>
                                    <constructor-arg value="7"/>
                                </bean>
                            </constructor-arg>
                        </bean>
                    </property>
                </bean>
                
                <!-- SBT metadata cache -->
                <bean class="org.apache.ignite.configuration.CacheConfiguration">
                    <property name="name" value="sbt_metadata"/>
                    <property name="atomicityMode" value="ATOMIC"/>
                    <property name="cacheMode" value="PARTITIONED"/>
                    <property name="backups" value="1"/>
                    <property name="statisticsEnabled" value="true"/>
                </bean>
                
                <!-- Presentation sessions cache -->
                <bean class="org.apache.ignite.configuration.CacheConfiguration">
                    <property name="name" value="presentation_sessions"/>
                    <property name="atomicityMode" value="ATOMIC"/>
                    <property name="cacheMode" value="PARTITIONED"/>
                    <property name="backups" value="1"/>
                    <property name="statisticsEnabled" value="true"/>
                    <property name="expiryPolicyFactory">
                        <bean class="javax.cache.expiry.CreatedExpiryPolicy" factory-method="factoryOf">
                            <constructor-arg>
                                <bean class="javax.cache.expiry.Duration">
                                    <constructor-arg value="HOURS"/>
                                    <constructor-arg value="1"/>
                                </bean>
                            </constructor-arg>
                        </bean>
                    </property>
                </bean>
            </list>
        </property>
        
        <!-- Discovery configuration -->
        <property name="discoverySpi">
            <bean class="org.apache.ignite.spi.discovery.tcp.TcpDiscoverySpi">
                <property name="ipFinder">
                    <bean class="org.apache.ignite.spi.discovery.tcp.ipfinder.multicast.TcpDiscoveryMulticastIpFinder">
                        <property name="addresses">
                            <list>
                                <value>127.0.0.1:47500..47509</value>
                            </list>
                        </property>
                    </bean>
                </property>
            </bean>
        </property>
        
        <!-- Enable REST API -->
        <property name="connectorConfiguration">
            <bean class="org.apache.ignite.configuration.ConnectorConfiguration">
                <property name="port" value="11211"/>
            </bean>
        </property>
        
        <!-- Client connector configuration -->
        <property name="clientConnectorConfiguration">
            <bean class="org.apache.ignite.configuration.ClientConnectorConfiguration">
                <property name="port" value="10800"/>
            </bean>
        </property>
    </bean>
</beans> 